{
	"name": "threlte-kit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:server": "cd server && ./run.sh",
		"dev:all": "concurrently -k -n server,web -c blue,green \"bun run dev:server\" \"bun run dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"schemas": "bun scripts/build-schemas.ts",
		"lint": "prettier --check . && eslint .",
		"test": "bun vitest run",
		"test:watch": "bun vitest",
		"test:coverage": "bun vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/svelte": "^5.2.7",
		"@types/three": "^0.185.0",
		"@vite-pwa/sveltekit": "^0.6.7",
		"@vitest/coverage-c8": "^0.33.0",
		"ajv": "^8.20.0",
		"bun-types": "^1.2.9",
		"c8": "^10.1.3",
		"concurrently": "^10.0.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"typescript-json-schema": "^0.68.0",
		"vite": "^6.0.0",
		"vitest": "^3.1.1"
	},
	"dependencies": {
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"add": "^2.0.6",
		"bun": "^1.2.9",
		"svelte-french-toast": "^1.2.0",
		"svelte-tweakpane-ui": "^1.5.6",
		"three": "^0.185.1"
	}
}
