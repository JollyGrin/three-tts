{
	"description": "table.place scenario (.tbps.json) — see docs/packs.md",
	"allOf": [
		{
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"title": "name"
				},
				"createdAt": {
					"type": "number",
					"title": "createdAt"
				},
				"state": {
					"$ref": "#/definitions/Partial%3CGameDTO%3E",
					"title": "state"
				}
			},
			"required": ["createdAt", "name", "state"]
		},
		{
			"type": "object",
			"properties": {
				"tbps": {
					"description": "format discriminator + version",
					"type": "number",
					"const": 1,
					"title": "tbps"
				},
				"$schema": {
					"description": "optional editor-validation hint; always written on export",
					"type": "string",
					"title": "$schema"
				}
			},
			"required": ["tbps"]
		}
	],
	"definitions": {
		"Partial<GameDTO>": {
			"title": "Partial<GameDTO>",
			"type": "object",
			"properties": {
				"cards": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/definitions/Partial%3CCardDTO%3E"
					},
					"title": "cards"
				},
				"decks": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/definitions/Partial%3CDeckDTO%3E"
					},
					"title": "decks"
				},
				"players": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/definitions/Partial%3CPlayerDTO%3E"
					},
					"title": "players"
				},
				"overlays": {
					"description": "null = remove",
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{
								"$ref": "#/definitions/Partial%3COverlayDTO%3E"
							},
							{
								"type": "null"
							}
						]
					},
					"title": "overlays"
				},
				"pieces": {
					"description": "null = remove",
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{
								"$ref": "#/definitions/Partial%3CPieceDTO%3E"
							},
							{
								"type": "null"
							}
						]
					},
					"title": "pieces"
				}
			}
		},
		"Partial<CardDTO>": {
