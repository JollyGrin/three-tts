      "HideWhenFaceDown": false,
      "Hands": false,
      "CustomMesh": {
        "MeshURL": "http://cloud-3.steamusercontent.com/ugc/1026203216033710122/3BEA746270C8F197B39EC4F13125C5B4AA590D61/",
        "DiffuseURL": "",
        "NormalURL": "",
        "ColliderURL": "",
        "Convex": true,
        "MaterialIndex": 1,
        "TypeIndex": 0,
        "CustomShader": {
          "SpecularColor": {
            "r": 0.875,
            "g": 0.812880337,
            "b": 0.7463235
          },
          "SpecularIntensity": 0,
          "SpecularSharpness": 4,
          "FresnelStrength": 0.107142858
        },
        "CastShadows": true
      },
      "LuaScript": "CONFIG = {\r\n    MIN_VALUE = 0,\r\n    MAX_VALUE = 2,\r\n    FONT_COLOR = {0,0,0,100},\r\n    FONT_SIZE = 450,\r\n    LABEL_SIZE = 400,\r\n    LABEL_FONT_COLOR = {0,0,0,100},\r\n    LABEL_BG_COLOR = {100,100,100,10},\r\n    COLOR_HEX = \"#ffffff\",\r\n    TOOLTIP_SHOW = true,\r\n    VALUE = MAX_VALUE,\r\n}\r\n\r\nINJECTED_COUNTER = true\r\nfunction onload(saved_data)\r\n  CONFIG.VALUE = CONFIG.MAX_VALUE\r\n  Wait.time(createAll, 1, 0)\r\nend\r\nfunction hexToRGB(hex)\r\n    hex = hex:gsub(\"#\",\"\")\r\n    R = tonumber(hex:sub(1,2),16)/255\r\n    G = tonumber(hex:sub(3,4),16)/255\r\n    B = tonumber(hex:sub(5,6),16)/255\r\n    result = {r=R,g=G,b=B,a=100}\r\n    return result\r\nend\r\nfunction createAll()\r\n    if CONFIG.TOOLTIP_SHOW then\r\n        ttText = self.getName().. \": \" .. CONFIG.VALUE\r\n    else\r\n        ttText = self.getName()\r\n    end\r\n    local scale = {x=1.5, y=1.5, z=1.5}\r\n    local thickness = self.getBoundsNormalized().size.y\r\n    if self.name == \"Custom_Tile\" then\r\n        thickness = thickness*2\r\n        scale = {0.75, 0.75, 0.75}\r\n    end\r\n    self.createButton({\r\n        label = tostring(CONFIG.VALUE),\r\n        click_function = \"doNothing\",\r\n        tooltip=ttText,\r\n        function_owner = self,\r\n        alignment = 3,\r\n        position = {0,thickness/2,-1.6},\r\n        width = 0,\r\n        height = 0,\r\n        font_size = CONFIG.LABEL_SIZE,\r\n        scale=scale,\r\n        font_color= hexToRGB(CONFIG.COLOR_HEX),\r\n        color = CONFIG.LABEL_BG_COLOR\r\n        })\r\n    self.createButton({\r\n        label=\">\",\r\n        click_function=\"add\",\r\n        tooltip=\"+\",\r\n        function_owner=self,\r\n        position={0.6, thickness/2, -1.7},\r\n        height=400,\r\n        width=200,\r\n        alignment = 3,\r\n        scale=scale,\r\n        font_size=CONFIG.FONT_SIZE,\r\n        font_color={0,0,0,0},\r\n        color={0,0,0,0}\r\n        })\r\n    self.createButton({\r\n        label=\"<\",\r\n        click_function=\"subtract\",\r\n        tooltip=\"-\",\r\n        function_owner=self,\r\n        position={-0.6, thickness/2, -1.7},\r\n        height=400,\r\n        width=200,\r\n        alignment = 3,\r\n        scale=scale,\r\n        font_size=CONFIG.FONT_SIZE,\r\n        font_color={0,0,0,0},\r\n        color={0,0,0,0}\r\n        })\r\n    self.createButton({\r\n        label=\"RESET\",\r\n        click_function=\"reset\",\r\n        tooltip=\"Reset Health\",\r\n        function_owner=self,\r\n        position={0, thickness/2, -2.5},\r\n        height=100,\r\n        width=400,\r\n        alignment = 3,\r\n        scale=scale,\r\n        font_size=20,\r\n        font_color={0,0,0,0},\r\n        color={0,0,0,0}\r\n        })\r\n\r\n    setTooltips()\r\nend\r\n\r\nfunction doNothing(_obj, _color, alt_click)\r\nend\r\n\r\nfunction editName(_obj, _string, value)\r\n    self.editInput({value = self.getName()})\r\n    setTooltips()\r\nend\r\n\r\nfunction add_subtract(_obj, _color, alt_click)\r\n    mod = alt_click and -1 or 1\r\n    new_value = math.min(math.max(CONFIG.VALUE + mod, CONFIG.MIN_VALUE), CONFIG.MAX_VALUE)\r\n    if CONFIG.VALUE ~= new_value then\r\n        CONFIG.VALUE = new_value\r\n        updateVal()\r\n    end\r\nend\r\n\r\nfunction add(_obj, _color, alt_click)\r\n    add_subtract(_obj, _color, false)\r\nend\r\n\r\nfunction subtract(_obj, _color, alt_click)\r\n    add_subtract(_obj, _color, true)\r\nend\r\n\r\nfunction reset(_obj, _color, alt_click)\r\n    CONFIG.VALUE = CONFIG.MAX_VALUE\r\n    updateVal()\r\nend\r\n\r\nfunction updateVal()\r\n    self.editButton({\r\n        index = 0,\r\n        label = tostring(CONFIG.VALUE)\r\n        })\r\n    setTooltips()\r\nend\r\n\r\nfunction setTooltips()\r\n    if CONFIG.TOOLTIP_SHOW then\r\n        ttText = self.getName().. \": \" .. CONFIG.VALUE\r\n    else\r\n        ttText = self.getName()\r\n    end\r\n    self.editButton({\r\n        index = 0,\r\n        value = tostring(CONFIG.VALUE),\r\n        tooltip = ttText\r\n        })\r\nend",
      "LuaScriptState": "",
      "XmlUI": ""
    }
